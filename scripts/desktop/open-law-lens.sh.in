#!/bin/sh
# Public standalone launch; never provisions or selects a maintained runtime.
umask 077
export OPEN_LAW_LENS_STORAGE=standalone
export OPEN_LAW_LENS_ENVIRONMENT=@ENVIRONMENT@
export PYTHONDONTWRITEBYTECODE=1
export PI_RUN_METRICS_ENABLED="${PI_RUN_METRICS_ENABLED:-0}"
if [ -z "${PI_CODING_AGENT_DIR:-}" ]; then export PI_CODING_AGENT_DIR=@PI_AGENT_DIR@; fi
unset VIRTUAL_ENV PYTHONHOME PYTHONPATH UV_PROJECT_ENVIRONMENT
exec /usr/bin/python3 -I @ENGINE@ env --project @SOURCE@ run open-law-lens "$@"
